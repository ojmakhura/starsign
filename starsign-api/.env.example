# Copy to .env and adjust. docker compose, the Makefile and `source .env` (make dev-api) read it.
export TAG=latest
export API_IMAGE_NAME=ojmakhura/starsign-api
export PORTAL_IMAGE_NAME=ojmakhura/starsign-portal

# Webservice
export PORT=8085
export CONTEXT_PATH=/
# Server: client IP behind a proxy, and the internal-only actuator port
export FORWARD_HEADERS_STRATEGY=native
export MANAGEMENT_PORT=8086
export SPRING_THREADS_VIRTUAL_ENABLED=true
export MAX_UPLOAD_SIZE=50MB
export SPRING_LOGGING=INFO
export HIBERNATE_LOGGING=INFO
export APP_LOGGING=INFO

# Database (docker compose points the webservice at its own postgres container instead of DATABASE_URL)
export DATABASE_URL=jdbc:postgresql://localhost:5432/starsign
export DB_NAME=starsign
export DB_USERNAME=starsign
export DB_PASSWORD=change-me
export DB_PORT=5432
export SHOW_SQL=false
export GENERATE_DDL=true

# Redis (docker compose uses its own redis container)
export REDIS_HOST=localhost
export REDIS_PORT=6379
export REDIS_PASSWORD=
export REDIS_TIMEOUT=2000

# Observability: turns on OTLP export of metrics, traces and logs to OTLP_URL
export OTLP_ENABLED=false
export OTLP_URL=http://localhost:4318
export TRACING_PROBABILITY=0.1

# Rate limiting: RATE_LIMIT is per second; the rest per rule period (register 1h, signing 1m, OTP 15m, verify 10m)
export RATE_LIMIT=30
export RATE_LIMIT_ENABLED=true
export RATE_LIMIT_REGISTER=5
export RATE_LIMIT_SIGNING=60
export RATE_LIMIT_OTP=5
export RATE_LIMIT_VERIFY=20

# Host ports (docker compose)
export API_PORT=8085
export PORTAL_PORT=4700
export KEYCLOAK_PORT=8080

# Keycloak as seen by the webservice, and by the browser (must give the same token issuer)
export AUTH_URL=http://localhost:8080
export KEYCLOAK_PUBLIC_URL=http://localhost:8080
export REALM=starsign
export API_CLIENT_ID=starsign-api
export PORTAL_CLIENT_ID=starsign-portal
export STARSIGN_API_CLIENT_SECRET=
export STARSIGN_PORTAL_URL=http://localhost:4700
export CORS_ALLOWED_ORIGINS=http://localhost:4700

# Keycloak authorization caches
export AUTHZ_PERMISSION_CACHE_TTL=5m
export AUTHZ_LOCAL_CACHE_TTL=1m
export AUTHZ_LOCAL_CACHE_MAX_SIZE=10000

# Keycloak admin (make up-all, make realm-import)
export KEYCLOAK_URL=http://localhost:8080
export KEYCLOAK_ADMIN=admin
export KEYCLOAK_ADMIN_PASSWORD=admin
export STARSIGN_BOOTSTRAP_ADMIN_PASSWORD=

# Object storage (SeaweedFS S3 gateway; docker compose runs one on port 8333)
export S3_ENDPOINT=http://localhost:8333
export S3_ACCESS_KEY=starsign
export S3_SECRET_KEY=starsign-secret
export S3_REGION=us-east-1
export S3_BUCKET=starsign-documents
export S3_CREATE_BUCKETS=true

# Novu (email / SMS). Disabled: notifications are recorded and logged, not sent
export NOVU_ENABLED=false
export NOVU_SECRET_KEY=
export NOVU_BASE_URL=https://api.novu.co
export NOVU_WORKFLOW_PREFIX=starsign-
# In-app notifications in the portal's Novu inbox (blank: kept in StarSign only)
export NOVU_APPLICATION_IDENTIFIER=
# Novu addresses the browser uses (blank API: NOVU_BASE_URL; blank socket: Novu Cloud's)
export NOVU_PUBLIC_API_URL=
export NOVU_PUBLIC_SOCKET_URL=

# PAdES signing certificate (a self-signed one is generated when missing and allowed)
export SIGNING_KEYSTORE_PATH=./data/signing/starsign-dev.p12
export SIGNING_KEYSTORE_PASSWORD=changeit
export SIGNING_KEY_ALIAS=starsign
export SIGNING_GENERATE_DEV_KEYSTORE=true
export SIGNING_TSA_URL=
# Completed documents: certify with "no changes allowed" and add long-term validation data
export SIGNING_CERTIFY_FINAL=true
export SIGNING_LTV=true
export SIGNING_REVOCATION_TIMEOUT_SECONDS=10

# Links in emails
export PORTAL_URL=http://localhost:4700
export SIGNING_PORTAL_URL=http://localhost:4700/sign

