<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="
                        http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!--
        Serves OutboxEventRepository.findDueIds. Partial: only unfinished events are indexed, so the
        index stays small while PUBLISHED and DEAD_LETTERED rows pile up. Ordered by created_at so the
        relay reads the oldest due events without sorting.
    -->
    <changeSet id="001-outbox-due-index" author="starsign">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="outbox_event"/>
        </preConditions>
        <sql>
            CREATE INDEX IF NOT EXISTS ix_outbox_event_due
                ON outbox_event (created_at, next_attempt_at)
                WHERE status IN ('PENDING', 'FAILED', 'PUBLISHING')
        </sql>
        <rollback>DROP INDEX IF EXISTS ix_outbox_event_due</rollback>
    </changeSet>
</databaseChangeLog>
