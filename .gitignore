# Root .gitignore for the starsign monorepo
#   starsign-api    — Java / Maven multi-module (common, core, webservice)
#   starsign-portal — Angular / Node
# Each sub-project also keeps its own .gitignore; this file covers both from the root.

# ---------------------------------------------------------------
# Secrets & per-environment config (never commit)
# ---------------------------------------------------------------
.env
.env.*
!.env.example
.env_file
**/public/env.json
starsign-api/starsign-api-stack.yml
*.pem
*.key
*.p12
*.jks
*.keystore

# ---------------------------------------------------------------
# starsign-api (Java / Maven)
# ---------------------------------------------------------------
**/target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar
dependency-reduced-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties
**/logs/
TEST*.xml
.vscode/
.claude/
.github/

# Eclipse / STS
**/.classpath
**/.project
**/.factorypath
**/.settings/
**/bin/
*.launch

# ---------------------------------------------------------------
# starsign-portal (Angular / Node)
# ---------------------------------------------------------------
**/node_modules/
starsign-portal/dist/
starsign-portal/tmp/
starsign-portal/out-tsc/
starsign-portal/bazel-out/
starsign-portal/coverage/
**/.angular
.sass-cache/
connect.lock
libpeerconnection.log
testem.log
typings/
__screenshots__/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache

# ---------------------------------------------------------------
# IDEs & editors
# ---------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.c9/
*.sublime-workspace
*.swp
*~
.history/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# Claude Code local (per-user) settings
.claude/settings.local.json

# ---------------------------------------------------------------
# Logs, temp & OS files
# ---------------------------------------------------------------
*.log
*.bak
*.tmp
*.ref
*.exc
.DS_Store
Thumbs.db
