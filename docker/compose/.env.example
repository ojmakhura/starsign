# Copy to .env (git-ignored) and adjust. `docker compose` in this folder reads it.
# Every value has a default in docker-compose.yml except the three Novu secrets.

# StarSign webservice and portal images
API_IMAGE_NAME=ojmakhura/starsign-api
API_TAG=latest
PORTAL_IMAGE_NAME=ojmakhura/starsign-portal
PORTAL_TAG=latest
API_PORT=28085
PORTAL_PORT=24700
# Portal runtime config mounted into the container: portal/env.json (ngrok) or portal/env.local.json (no ngrok)
PORTAL_ENV_JSON=./portal/env.json
# Addresses the browser uses (the ngrok overlay replaces both with the public URL)
PORTAL_PUBLIC_URL=http://localhost:24700
KEYCLOAK_PUBLIC_URL=http://localhost:28080
REALM=starsign
API_CLIENT_ID=starsign-api
PORTAL_CLIENT_ID=starsign-portal
SIGNING_KEYSTORE_PASSWORD=changeit
SIGNING_GENERATE_DEV_KEYSTORE=true
# Novu delivery: create an API key in the Novu dashboard, paste it here, set NOVU_ENABLED=true
NOVU_ENABLED=false
NOVU_API_KEY=
# OpenTelemetry: send the webservice's logs, traces and metrics to an OTLP/HTTP collector
OTLP_ENABLED=false
OTLP_URL=http://host.docker.internal:4318
TRACING_PROBABILITY=1.0

# Postgres (starsign database)
DB_NAME=starsign
DB_USERNAME=starsign
DB_PASSWORD=starsign
DB_PORT=25432

# Postgres (keycloak database, created on first start by postgres/init)
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# Redis (empty password = no auth). Novu uses db index 2.
REDIS_PASSWORD=
REDIS_PORT=26379

# RabbitMQ (management UI: http://localhost:35672)
RABBITMQ_USERNAME=starsign
RABBITMQ_PASSWORD=starsign
RABBITMQ_VHOST=starsign
RABBITMQ_PORT=25672
RABBITMQ_MANAGEMENT_PORT=35672

# SeaweedFS S3 gateway. The access/secret key must match ../seaweedfs-s3.json
S3_PORT=28333
SEAWEEDFS_MASTER_PORT=29333
S3_ACCESS_KEY=starsign
S3_SECRET_KEY=starsign-secret
S3_REGION=us-east-1
S3_BUCKET=starsign-documents
NOVU_S3_BUCKET=novu-local

# Keycloak (admin console: http://localhost:28080)
KEYCLOAK_PORT=28080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
STARSIGN_API_CLIENT_SECRET=
STARSIGN_BOOTSTRAP_ADMIN_PASSWORD=


# Novu (dashboard: http://localhost:24000)
NOVU_VERSION=3.20.0
NOVU_NODE_ENV=local
MONGO_USERNAME=novu
MONGO_PASSWORD=novu
NOVU_API_PORT=23000
NOVU_WS_PORT=23002
NOVU_DASHBOARD_PORT=24000
# Addresses the browser uses
NOVU_API_URL=http://localhost:23000
NOVU_WS_URL=http://localhost:23002
NOVU_DASHBOARD_URL=http://localhost:24000
# REQUIRED. JWT_SECRET and SECRET_KEY: openssl rand -hex 32
# STORE_ENCRYPTION_KEY must be exactly 32 characters: openssl rand -hex 16
NOVU_JWT_SECRET=
NOVU_SECRET_KEY=
NOVU_STORE_ENCRYPTION_KEY=

# ngrok overlay (docker-compose.ngrok.yml). Uncomment COMPOSE_FILE to always use it.
# COMPOSE_FILE=docker-compose.yml:docker-compose.ngrok.yml
# Your static domain, without https:// (ngrok dashboard -> Domains)
NGROK_DOMAIN=
# ngrok dashboard -> Your Authtoken
NGROK_AUTHTOKEN=
# Local port Caddy listens on; the ngrok container forwards to it
PROXY_PORT=28000
# What / routes to: the portal container (localhost:24700) or ng serve (localhost:4700)
PORTAL_UPSTREAM=localhost:24700
